# Add inside momo-aigc's existing server{}; retain all existing routes/timeouts.
# This must be installed before enabling the application health endpoints.
location ^~ /api/internal/monitor/ {
    allow 127.0.0.1;
    allow ::1;
    deny all;
    proxy_pass http://127.0.0.1:3000;
    proxy_set_header X-Monitor-Token $http_x_monitor_token;
    proxy_connect_timeout 2s;
    proxy_read_timeout 2s;
    access_log off;
}
# Separate log; do not remove/replace the existing access_log.
access_log /var/log/nginx/momo-diagnostics.jsonl momo_diagnostics if=$momo_diag_loggable;
