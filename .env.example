# Server
JWT_SECRET=change-me-to-a-random-string
PORT=3000

# 用户个人 ToAPIs Key 加密密钥（64 位 hex；留空则启动时从 JWT_SECRET 派生兜底）
# 生成示例：openssl rand -hex 32
ENCRYPTION_KEY=

# Alibaba Cloud OSS
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=your-bucket-name
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret
OSS_RESULT_IMPORT_WORKER_URL=https://your-worker.example.com/import-result
OSS_RESULT_IMPORT_WORKER_SECRET=change-me

# ToAPIs Base URL
TOAPIS_BASE_URL=https://toapis.com

# Email SMTP（验证码邮件发信通道）
# 阿里云 DirectMail: SMTP_HOST=smtpdm.aliyun.com, SMTP_PORT=465, SMTP_SECURE=true
# SMTP_USER 为发信地址（如 noreply@yourdomain.com），SMTP_PASS 为该发信地址的 SMTP 密码
# SMTP_FROM 为发件人显示地址（一般与 SMTP_USER 一致）
# 留空 SMTP_HOST 则验证码打印到服务端控制台（开发降级模式）
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
