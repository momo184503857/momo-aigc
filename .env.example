# Server
JWT_SECRET=change-me-to-a-random-string
PORT=3000

# 用户个人 ToAPIs Key 加密密钥（64 位 hex；留空则启动时从 JWT_SECRET 派生兜底）
# 生成示例：openssl rand -hex 32
ENCRYPTION_KEY=

# Alibaba Cloud OSS（可选）
# 不配置即工作在「直接传」模式：图片存本机磁盘（server/data/uploads/），无需任何云存储。
# 如需切换为 OSS：管理后台 → 配置 → 存储 页签填写（存数据库，优先级高于此处 env；推荐在后台配置）。
# env 仅作为后台表单的兜底预填值。
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# 结果转存 FC Worker 地址（仅 OSS 模式需要；直接传模式服务端直接下载上传，无需 Worker）
OSS_RESULT_IMPORT_WORKER_URL=
OSS_RESULT_IMPORT_WORKER_SECRET=

# ToAPIs Base URL
TOAPIS_BASE_URL=https://toapis.xyz

# Email SMTP（验证码邮件发信通道）
# 阿里云 DirectMail: SMTP_HOST=smtpdm.aliyun.com, SMTP_PORT=465, SMTP_SECURE=true
# SMTP_USER 为发信地址（如 noreply@yourdomain.com），SMTP_PASS 为该发信地址的 SMTP 密码
# SMTP_FROM 为发件人显示地址（一般与 SMTP_USER 一致）
# 留空 SMTP_HOST 则验证码打印到服务端控制台（开发降级模式）
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# 拉取生产数据库到本地（bash scripts/pull-db.sh 或 npm run pull-db）
# 服务器地址必填：REMOTE_HOST 填生产服务器 IP，脚本以 root@REMOTE_HOST 连接；项目路径默认 ~/momo-aigc
REMOTE_HOST=
REMOTE_USER=
REMOTE_PORT=
REMOTE_PATH=
